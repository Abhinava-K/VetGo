PORT=4000
MONGO_URI=
JWT_SECRET=REPLACE_WITH_RANDOM_LONG_STRING
REFRESH_TOKEN_SECRET=REPLACE_WITH_ANOTHER_RANDOM_LONG_STRING
FIELD_ENC_KEY=REPLACE_WITH_BASE64_32_BYTES_KEY
BCRYPT_SALT_ROUNDS=12
NODE_ENV=development

# Real SMS Gateway Providers (Fast2SMS for India or Twilio)
# Option A: Fast2SMS (Get free API key at https://www.fast2sms.com)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Option B: Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
